package com.suxsem.havoicecontrol

import android.content.Context
import android.media.AudioFormat
import android.media.MediaRecorder
import ai.onnxruntime.OnnxTensor
import ai.onnxruntime.OrtEnvironment
import ai.onnxruntime.OrtProvider
import ai.onnxruntime.OrtSession
import android.annotation.SuppressLint
import android.media.AudioRecord
import android.media.audiofx.AutomaticGainControl
import android.media.audiofx.NoiseSuppressor
import kotlinx.coroutines.*
import java.nio.ByteBuffer
import java.nio.ByteOrder
import java.util.ArrayDeque
import java.util.Collections

private const val NORM_FACTOR = 1.0f / 32768.0f

private enum class VadMode {
    SPEEX_LISTENING,
    SILERO_STREAMING
}

class WakeWordDetector(
    private val context: Context,
    private val modelFile: String,
    private val verifierFile: String,
    private val minScore: Float,
    private val verifierScore: Float,
    private val onDetected: (prob: Float) -> Unit
) {
    private val maxBatchSize = 16 // per riempire esattamente la finestra di osservazione del modello
    private val audioFrameSize = 256
    private val sampleRate = 16000
    private val frameSamples = 1280 // 80ms a 16kHz
    private val embeddingSize = 96
    private val numEmbeddings = 16

    @SuppressLint("MissingPermission")
    private val audioRecord = AudioRecord(
        MediaRecorder.AudioSource.VOICE_RECOGNITION,
        sampleRate,
        AudioFormat.CHANNEL_IN_MONO,
        AudioFormat.ENCODING_PCM_16BIT,
        sampleRate * 5 // 5 seconds
    )
    private var hwAgc: AutomaticGainControl? = null
    private var hwNs: NoiseSuppressor? = null

    private val ringBuffer = AudioRingBuffer(sampleRate * 8) // 8 secondi

    private val melSize = 32          // Numero di coefficienti Mel per ogni frame
    private val melWindowSize = 76    // Finestra temporale richiesta dal modello (76 frame)
    private val melFrameStep = 8      // Avanzamento temporale per ogni step (8 frame)

    private val melBuffer = MelRingBuffer(melWindowSize + (maxBatchSize * melFrameStep), melSize)
    private val embeddingBuffer = ArrayDeque<FloatArray>(numEmbeddings)

    private val flatMelBuffer = ByteBuffer.allocateDirect(maxBatchSize * melWindowSize * melSize * 4).order(ByteOrder.nativeOrder()).asFloatBuffer()
    private val flatClassBuffer = ByteBuffer.allocateDirect(numEmbeddings * embeddingSize * 4).order(ByteOrder.nativeOrder()).asFloatBuffer()
    private val modelInputBuffer = ByteBuffer.allocateDirect(numEmbeddings * 1760 * 4).order(ByteOrder.nativeOrder()).asFloatBuffer()

    private var isVADActive = false
    private var vadCycleCount = 0
    private var cooldownCycles = 0
    private val cooldownTotalCycles = 40 // = 1.28 secondi
    private var isPaused = false
    private val env = OrtEnvironment.getEnvironment()
    private lateinit var sileroSession: OrtSession
    private lateinit var melSession: OrtSession
    private lateinit var embSession: OrtSession
    private lateinit var classifierSession: OrtSession
    private lateinit var verifierSession: OrtSession

    // Nomi input cachati per evitare allocazione Iterator ad ogni inferenza
    private lateinit var melInputName: String
    private lateinit var embInputName: String
    private lateinit var classifierInputName: String
    private lateinit var verifierInputName: String

    // Map pre-allocata per gli input di Silero VAD (evita mapOf() ad ogni frame)
    private val sileroInputs = HashMap<String, OnnxTensor>(3)

    // Stati ricorrenti per Silero VAD (LSTM/GRU) - direct buffer per zero-copy tensor creation
    private val vadStateBuffer = ByteBuffer.allocateDirect(256 * 4).order(ByteOrder.nativeOrder()).asFloatBuffer()

    // Buffer per l'input SR (Sample Rate) richiesto dal modello op15
    private val vadAudioBuffer = ByteBuffer.allocateDirect(576 * 4).order(ByteOrder.nativeOrder()).asFloatBuffer()

    private val srBuffer = ByteBuffer.allocateDirect(8).order(ByteOrder.nativeOrder()).asLongBuffer().apply { put(16000L); rewind() }

    private var speexWrapper = SpeexWrapper()

    private val tempBuffer = ShortArray(audioFrameSize)
    private val vadSampleBuffer = ShortArray(512) // pre-allocato per runSileroVAD
    private val stepAudioBuffer = ShortArray(maxBatchSize * frameSamples + 480) // pre-allocato per runStep/warmup
    private var vadActivationTime: Long = 0L


    private var isSpeechTriggered = false
    private var speechCounter = 0
    private var silenceCounter = 0

    // Soglie calcolate (300ms / 32ms ≈ 10 | 150ms / 32ms ≈ 5)
    private val minSpeechFrames = 10
    private val minSilenceFrames = 5

    // Macchina a stati Speex → Silero
    private var vadMode = VadMode.SPEEX_LISTENING
    private var sileroFalseCounter = 0
    private val sileroCooldownFrames = 312 // 10000ms / 32ms ≈ 312 frame


    init {
        loadModels()
        speexWrapper.initSpeex()

        if (AutomaticGainControl.isAvailable()) {
            hwAgc = AutomaticGainControl.create(audioRecord.audioSessionId)
            hwAgc!!.enabled = true
        }

        if (NoiseSuppressor.isAvailable()) {
            hwNs = NoiseSuppressor.create(audioRecord.audioSessionId)
            hwNs!!.enabled = true
        }

    }

    private fun loadModels() {
        val opts = OrtSession.SessionOptions()
        // Attiva il massimo livello di ottimizzazione
        opts.setOptimizationLevel(OrtSession.SessionOptions.OptLevel.ALL_OPT)

        val numCores = Runtime.getRuntime().availableProcessors()
        val optimalThreads = numCores.coerceAtLeast(1).coerceAtMost(2)
        opts.setIntraOpNumThreads(optimalThreads)

        val available = OrtEnvironment.getAvailableProviders()

        if (available.contains(OrtProvider.NNAPI)) {
            opts.addNnapi()
        }
        if (available.contains(OrtProvider.XNNPACK)) {
            opts.addXnnpack(Collections.emptyMap())
        }
        if (available.contains(OrtProvider.QNN)) {
            opts.addQnn(mapOf("backend_path" to "libQnnHtp.so"))
        }

        sileroSession = env.createSession(context.assets.open("silero_vad_16k_op15.onnx").readBytes(), opts)
        melSession = env.createSession(context.assets.open("melspectrogram.onnx").readBytes(), opts)
        embSession = env.createSession(context.assets.open("embedding_model.onnx").readBytes(), opts)
        classifierSession = env.createSession(context.assets.open(modelFile).readBytes(), opts)
        verifierSession = env.createSession(context.assets.open(verifierFile).readBytes(), opts)

        // Cache dei nomi input
        melInputName = melSession.inputNames.iterator().next()
        embInputName = embSession.inputNames.iterator().next()
        classifierInputName = classifierSession.inputNames.iterator().next()
        verifierInputName = verifierSession.inputNames.iterator().next()
    }

    private fun reset() {
        // 1. Reset del RingBuffer Audio
        ringBuffer.clear()

        // 2. Reset delle code Mel ed Embedding (ripristina lo stato iniziale "vuoto")
        melBuffer.reset()
        embeddingBuffer.clear()
        repeat(numEmbeddings) {
            embeddingBuffer.add(FloatArray(embeddingSize))
        }

        // 3. Reset variabili di stato e logica VAD
        isVADActive = false
        vadCycleCount = 0
        cooldownCycles = 0

        // 4. Reset degli stati ricorrenti di Silero VAD
        resetSileroState()

        // 5. Reset macchina a stati Speex → Silero
        vadMode = VadMode.SPEEX_LISTENING
        sileroFalseCounter = 0

    }

    fun releaseResources() {
        isPaused = true

        // 1. Ferma e rilascia l'hardware audio
        hwAgc?.enabled = false
        hwAgc?.release()
        hwAgc = null

        hwNs?.enabled = false
        hwNs?.release()
        hwNs = null

        audioRecord.stop()
        audioRecord.release()

        // 2. Chiudi tutte le sessioni ONNX individualmente
        // È importante farlo prima di chiudere l'ambiente (env)
        try {
            if (::sileroSession.isInitialized) sileroSession.close()
            if (::melSession.isInitialized) melSession.close()
            if (::embSession.isInitialized) embSession.close()
            if (::classifierSession.isInitialized) classifierSession.close()
            if (::verifierSession.isInitialized) verifierSession.close()
        } catch (e: Exception) {
        }

        // 3. Chiudi l'ambiente ONNX
        env.close()

        // 4. Pulisci le risorse esterne
        speexWrapper.destroySpeex()

    }

    fun pauseDetection() {
        isPaused = true
        audioRecord.stop()
    }

    suspend fun startDetection() = withContext(Dispatchers.Default) {

        reset()
        isPaused = false
        audioRecord.startRecording()

        while (isActive && !isPaused) {

            var speexActive = false

            repeat (2) { // silero vuole 512 campioni
                if (audioRecord.read(
                        tempBuffer,
                        0,
                        audioFrameSize,
                        AudioRecord.READ_BLOCKING
                    ) != audioFrameSize
                ) {
                    if (isPaused) break
                    continue // WebRTC non ha ancora prodotto abbastanza dati
                }

                if (speexWrapper.processAudio(tempBuffer))
                    speexActive = true

                if (isPaused) break

                ringBuffer.addBlock(tempBuffer, audioFrameSize)

            }

            // Gestione Cooldown (indipendente dal vadMode)
            if (cooldownCycles > 0) {
                cooldownCycles--
                isVADActive = false
                vadCycleCount = 0
                continue
            }

            val speechDetected: Boolean

            when (vadMode) {
                VadMode.SPEEX_LISTENING -> {
                    if (speexActive) {
                        // Speex ha rilevato attività: attiva Silero con warmup
                        val warmupResult = performSileroWarmup()
                        vadMode = VadMode.SILERO_STREAMING
                        sileroFalseCounter = 0
                        speechDetected = warmupResult
                    } else {
                        speechDetected = false
                    }
                }
                VadMode.SILERO_STREAMING -> {
                    val sileroResult = runSileroVAD()
                    if (sileroResult) {
                        sileroFalseCounter = 0
                    } else {
                        sileroFalseCounter++
                        if (sileroFalseCounter >= sileroCooldownFrames) {
                            // 10s di silenzio: torna a Speex
                            resetSileroState()
                            vadMode = VadMode.SPEEX_LISTENING
                            isVADActive = false
                            vadCycleCount = 0
                        }
                    }
                    speechDetected = sileroResult
                }
            }

            if (speechDetected) {
                if (isVADActive) {
                    vadCycleCount++
                    if (vadCycleCount == 5) {
                        runStep(numSteps = 2)
                        vadCycleCount = 0
                    }
                } else {
                    vadActivationTime = System.currentTimeMillis()
                    runStep(numSteps = maxBatchSize)
                    isVADActive = true
                    vadCycleCount = 0
                }
            } else {
                isVADActive = false
            }

        }

    }

    private fun resetSileroState() {
        for (i in 0 until 256) vadStateBuffer.put(i, 0f)
        speechCounter = 0
        silenceCounter = 0
        isSpeechTriggered = false
    }

    /**
     * Esegue inferenza Silero su vadAudioBuffer già preparato (512 campioni normalizzati).
     * Aggiorna lo stato ricorrente e la logica di triggering.
     */
    private fun runSileroOnCurrentAudio(): Boolean {
        vadAudioBuffer.rewind()
        val inputTensor = OnnxTensor.createTensor(env, vadAudioBuffer, longArrayOf(1, 576))
        srBuffer.rewind()
        val srTensor = OnnxTensor.createTensor(env, srBuffer, longArrayOf(1))
        vadStateBuffer.rewind()
        val stateTensor = OnnxTensor.createTensor(env, vadStateBuffer, longArrayOf(2, 1, 128))

        sileroInputs.clear()
        sileroInputs["input"] = inputTensor
        sileroInputs["sr"] = srTensor
        sileroInputs["state"] = stateTensor

        return try {
            @Suppress("UNCHECKED_CAST")
            sileroSession.run(sileroInputs).use { results ->

                val output = results[0].value as Array<FloatArray>
                val probability = output[0][0]

                val newState = results[1].value as Array<Array<FloatArray>>
                var index = 0
                for (i in 0 until 2) {
                    for (j in 0 until 1) {
                        vadStateBuffer.position(index)
                        vadStateBuffer.put(newState[i][j], 0, 128)
                        index += 128
                    }
                }

                val threshold = 0.6f
                val negThreshold = threshold - 0.15f

                if (probability >= threshold) {
                    silenceCounter = 0
                    speechCounter++
                    if (speechCounter >= minSpeechFrames && !isSpeechTriggered) {
                        isSpeechTriggered = true
                    }
                } else if (probability < negThreshold) {
                    speechCounter = 0
                    if (isSpeechTriggered) {
                        silenceCounter++
                        if (silenceCounter >= minSilenceFrames) {
                            isSpeechTriggered = false
                        }
                    }
                }

                isSpeechTriggered
            }
        } finally {
            inputTensor.close()
            srTensor.close()
            stateTensor.close()
        }
    }

    private fun runSileroVAD(): Boolean {
        ringBuffer.getLastSamplesInto(vadSampleBuffer, 512)
        var i = 0
        while (i < 512) {
            vadAudioBuffer.put(i, vadSampleBuffer[i] * NORM_FACTOR)
            i++
        }
        return runSileroOnCurrentAudio()
    }

    /**
     * Warmup di Silero: processa 10 chunk da 512 campioni dal ring buffer
     * in ordine cronologico per dare coerenza allo stato LSTM.
     */
    private fun performSileroWarmup(): Boolean {
        val warmupChunks = 10
        val chunkSize = 512
        val totalSamples = warmupChunks * chunkSize
        ringBuffer.getLastSamplesInto(stepAudioBuffer, totalSamples)
        var detected = false

        for (c in 0 until warmupChunks) {
            val offset = c * chunkSize
            for (i in 0 until chunkSize) {
                vadAudioBuffer.put(i, stepAudioBuffer[offset + i] * NORM_FACTOR)
            }
            if (runSileroOnCurrentAudio()) {
                detected = true
            }
        }

        return detected
    }

    /**
     * Esegue il mantenimento della pipeline per N step da 80ms
     */
    private fun runStep(numSteps: Int) {

        // Per N step, abbiamo bisogno di (N * 1280) nuovi + 480 iniziali di contesto
        val contextSize = 480
        val totalAudioToFetch = (numSteps * frameSamples) + contextSize

        ringBuffer.getLastSamplesInto(stepAudioBuffer, totalAudioToFetch)

        for (i in 0 until numSteps) {
            val sourceOffset = i * frameSamples
            val destinationOffset = i * 1760

            for (j in 0 until 1760) {
                modelInputBuffer.put(destinationOffset + j, stepAudioBuffer[sourceOffset + j].toFloat())
            }
        }

        runMelInferenceBatch(numSteps)
        runEmbeddingInferenceBatch(numSteps)
        checkWakeWord()
    }

    /**
     * Esegue l'inferenza Mel e restituisce una lista piatta di frame (8 frame per ogni 80ms).
     */
    /**
     * Legge direttamente dal buffer nativo di ONNX e aggiorna la coda Mel.
     * Zero allocazioni di liste intermedie.
     */
    /**
     * Esegue l'inferenza Mel su un batch di audio.
     * @param batchSize Il numero di blocchi da 80ms contenuti nell'audio
     */
    private fun runMelInferenceBatch(batchSize: Int) {

        modelInputBuffer.rewind()
        modelInputBuffer.limit(batchSize * 1760)

        val tensorInput = OnnxTensor.createTensor(env, modelInputBuffer, longArrayOf(batchSize.toLong(), 1760L))

        tensorInput.use {
            val output = melSession.run(Collections.singletonMap(melInputName, it))
            output.use { melOut ->
                val outTensor = melOut[0] as OnnxTensor

                val flatBuffer = outTensor.floatBuffer
                flatBuffer.rewind()

                // 1. Aggiorniamo il ring buffer Mel (la nostra storia temporale)
                repeat(batchSize * 8) {
                    val reusableFrame = melBuffer.advance()
                    for (f in 0 until melSize) {
                        reusableFrame[f] = (flatBuffer.get() / 10.0f) + 2.0f
                    }
                }
            }
        }

        modelInputBuffer.clear()

        val totalAvailable = melBuffer.size

        for (b in 0 until batchSize) {
            val batchOffset = b * melWindowSize * melSize
            val stepsBack = (batchSize - 1 - b) * melFrameStep
            val startFrameIdx = (totalAvailable - melWindowSize) - stepsBack

            for (f in 0 until melWindowSize) {
                val frame = melBuffer[startFrameIdx + f]
                flatMelBuffer.position(batchOffset + (f * melSize))
                flatMelBuffer.put(frame, 0, melSize)
            }
        }
    }

    private fun runEmbeddingInferenceBatch(batchSize: Int) {
        val totalElements = batchSize * melWindowSize * melSize
        flatMelBuffer.rewind()
        flatMelBuffer.limit(totalElements)

        val tensor = OnnxTensor.createTensor(env, flatMelBuffer,
            longArrayOf(batchSize.toLong(), melWindowSize.toLong(), melSize.toLong(), 1L))

        tensor.use {
            val output = embSession.run(Collections.singletonMap(embInputName, it))
            output.use { embOut ->
                val outTensor = embOut[0] as OnnxTensor
                val outBuffer = outTensor.floatBuffer

                repeat(batchSize) {
                    val reusableEmbedding = embeddingBuffer.removeFirst()
                    outBuffer.get(reusableEmbedding)
                    embeddingBuffer.addLast(reusableEmbedding)
                }
            }
        }

        flatMelBuffer.clear()
    }

    private fun checkWakeWord() {

        // 2. Compattazione degli embedding nel direct buffer
        flatClassBuffer.clear()
        for (emb in embeddingBuffer) {
            flatClassBuffer.put(emb, 0, embeddingSize)
        }

        // 3. Creazione del Tensore [1, 16, 96]
        val shape = longArrayOf(1, numEmbeddings.toLong(), embeddingSize.toLong())
        flatClassBuffer.rewind()
        val tensor = OnnxTensor.createTensor(env, flatClassBuffer, shape)

        tensor.use {
            // Esecuzione dell'inferenza sul classificatore finale
            val output = classifierSession.run(Collections.singletonMap(classifierInputName, it))

            output.use { res ->
                // Estrazione della probabilità (Output atteso: [1, 1])
                @Suppress("UNCHECKED_CAST")
                val outValues = res[0].value as Array<FloatArray>
                val probability = outValues[0][0]

                // 4. Soglia di attivazione diretta
                if (probability >= minScore) {

                    if (verifierScore > 0) {

                        // --- STEP 2: VERIFIER (Solo se il primo ha dato l'OK) ---
                        val verifierOutput =
                            verifierSession.run(Collections.singletonMap(verifierInputName, it))

                        verifierOutput.use { vRes ->
                            @Suppress("UNCHECKED_CAST")
                            val vValues = vRes[0].value as Array<FloatArray>

                            // Nota: In Python fa [0][-1]. Se il tuo ONNX del verifier
                            // ha output [1, 1], usa [0][0]. Se ha [1, 2], usa .last()
                            val verifiedScore =
                                vValues[0].last() //TODO verificare forma output modello

                            if (verifiedScore >= verifierScore) {
                                wakeWordDetected(verifierScore)
                            }
                        }

                    } else {
                        wakeWordDetected(probability)
                    }
                }
            }
        }
    }

    private fun wakeWordDetected(score: Float) {
        val detectionTime = System.currentTimeMillis()
        val delta = detectionTime - vadActivationTime

        cooldownCycles = cooldownTotalCycles
        onDetected(score)
    }

    class MelRingBuffer(val size: Int, private val frameSize: Int) {
        private val data = Array(size) { FloatArray(frameSize) }
        private var head = 0 // punta al frame più vecchio

        operator fun get(index: Int): FloatArray = data[(head + index) % size]

        fun advance(): FloatArray {
            val frame = data[head]
            head = (head + 1) % size
            return frame
        }

        fun reset() {
            head = 0
            for (frame in data) frame.fill(0f)
        }
    }

    class AudioRingBuffer(private val capacity: Int) {
        private val buffer = ShortArray(capacity)
        private var writeIndex = 0

        fun addBlock(samples: ShortArray, size: Int) {
            val limit = if (size > capacity) capacity else size
            val spaceToEnd = capacity - writeIndex
            if (limit <= spaceToEnd) {
                System.arraycopy(samples, 0, buffer, writeIndex, limit)
            } else {
                System.arraycopy(samples, 0, buffer, writeIndex, spaceToEnd)
                System.arraycopy(samples, spaceToEnd, buffer, 0, limit - spaceToEnd)
            }
            writeIndex = (writeIndex + limit) % capacity
        }

        fun getLastSamplesInto(dest: ShortArray, n: Int) {
            var readIndex = writeIndex - n
            while (readIndex < 0) readIndex += capacity

            val spaceToEnd = capacity - readIndex
            if (n <= spaceToEnd) {
                System.arraycopy(buffer, readIndex, dest, 0, n)
            } else {
                System.arraycopy(buffer, readIndex, dest, 0, spaceToEnd)
                System.arraycopy(buffer, 0, dest, spaceToEnd, n - spaceToEnd)
            }
        }

        fun clear() {
            writeIndex = 0
            buffer.fill(0)
        }
    }

}

